# Secrets
.env
# The template IS committed. Negated because a global gitignore may exclude .env.*
!.env.example

# Real personal data never leaves the laptop
data/private/

# Generated output
out/

# Frontend: node_modules and the Next build cache are not committed.
# The BUILT export at src/wingman/web/static IS committed on purpose, so that
# `git clone && uv sync && wingman web` works without Node installed at all.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Python
.venv/
__pycache__/
*.pyc

# Cognee local state (if run without cloud)
.cognee_system/
.data_storage/

# macOS
.DS_Store
.cognee_cache/
.pytest_cache/

