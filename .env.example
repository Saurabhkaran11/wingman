# Copy to .env and fill in. Never commit .env.
# Run `uv run wingman doctor` after editing: it live-checks every line below.

# --- Cognee Cloud (the brain) ---
# Console -> API Keys. Tenant URL looks like https://<tenant>.aws.cognee.ai
COGNEE_CLOUD_URL=
COGNEE_API_KEY=
# Only for local (non-cloud) Cognee: an OpenAI key used for graph building.
LLM_API_KEY=

# --- Bright Data (the web) ---
# The Bright Data MCP server reads this exact variable name.
API_TOKEN=

# --- LLM for the agent: fill in ONE provider ---
# Option A: Amazon Bedrock (Strands default)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Option B: Anthropic API (used automatically when this is set)
ANTHROPIC_API_KEY=
# Optional overrides: "bedrock" or "anthropic", and a specific model id.
WINGMAN_MODEL_PROVIDER=
WINGMAN_MODEL_ID=

# --- Who "me" is ---
# Your own address: tells "me" from "them" on calendar invites.
WINGMAN_ME=alex@example.com
WINGMAN_ME_NAME=Alex Rivera
# Name of the Cognee dataset. Use a different one (e.g. "personal") for real data.
WINGMAN_DATASET=wingman

# --- Real-time calendar (optional) ---
# A local .ics path, or a live feed: Google Calendar -> Settings -> your calendar
# -> "Secret address in iCal format". Blank = data/sample/calendar.ics
WINGMAN_CALENDAR=

# --- Gmail (optional): sends the brief to you, and powers `wingman ingest-gmail` ---
# Create an app password at https://myaccount.google.com/apppasswords (needs 2FA).
SMTP_USER=
SMTP_APP_PASSWORD=
