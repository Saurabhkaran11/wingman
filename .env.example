# Copy to .env and fill in. Never commit .env.
# Run `uv run wingman doctor` after editing: it live-checks every line.
#
# ─────────────────────────────────────────────────────────────────────────
# FASTEST PATH WITH NO CREDIT CARD (about 5 minutes)
#   1. GROQ_API_KEY    — console.groq.com, ~1,000 requests/day, no card.
#      GEMINI_API_KEY too (aistudio.google.com/apikey): it also powers
#      Cognee's local graph building, and adds a fallback.
#   2. API_TOKEN       — Bright Data. Free tier is 5,000 requests/month.
#   3. Leave COGNEE_CLOUD_URL blank and use the LOCAL block below.
# ─────────────────────────────────────────────────────────────────────────

# --- LLM for the agent: set AS MANY as you like ---
# They form a fallback chain, best free tier first. When one hits its daily cap
# mid-run, Wingman moves to the next instead of failing. More keys = more runs.
#
# A. Groq — the most generous free tier (~1,000 requests/day vs Gemini's ~20),
#    and the fastest. console.groq.com, no credit card. Leads the chain when set.
GROQ_API_KEY=
# B. Google Gemini — free, no card, but a thin daily cap. aistudio.google.com/apikey
GEMINI_API_KEY=
# C. OpenRouter — ~200 requests/day per model, one key reaches many. openrouter.ai
OPENROUTER_API_KEY=
# D. Anthropic
ANTHROPIC_API_KEY=
# E. Amazon Bedrock
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional overrides. Setting WINGMAN_MODEL_ID pins one model and disables the
# chain. WINGMAN_MODEL_CHAIN sets the order explicitly, e.g.
#   groq:llama-3.3-70b-versatile,gemini:gemini-3.5-flash
WINGMAN_MODEL_PROVIDER=
WINGMAN_MODEL_ID=
WINGMAN_MODEL_CHAIN=

# Cache Bright Data results for this many hours, so rehearsing a demo costs no
# credits and no waiting (a live search takes 45-100s). 0 disables it.
WINGMAN_WEB_CACHE_HOURS=12

# --- Bright Data (the live web) ---
# The MCP server reads this exact variable name. brightdata.com -> account settings.
API_TOKEN=

# --- Cognee (the brain): pick cloud OR local ---
# CLOUD: uses your hackathon credits. Console -> API Keys.
COGNEE_CLOUD_URL=
COGNEE_API_KEY=
# LOCAL: no Cognee account at all. Reuse the same free Gemini key here.
# Set all four together — changing only the LLM still defaults embeddings to OpenAI.
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini/gemini-flash-latest
#   LLM_API_KEY=<the same GEMINI_API_KEY value>
#   EMBEDDING_PROVIDER=gemini
#   EMBEDDING_MODEL=gemini/gemini-embedding-001
#   EMBEDDING_API_KEY=<the same GEMINI_API_KEY value>
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- Who "me" is ---
WINGMAN_ME=alex@example.com
WINGMAN_ME_NAME=Alex Rivera
# Name of the Cognee dataset. Use a different one (e.g. "personal") for real data.
WINGMAN_DATASET=wingman

# --- Real-time calendar (optional) ---
# A local .ics path, or Google Calendar -> Settings -> "Secret address in iCal format".
WINGMAN_CALENDAR=

# --- Gmail (optional): sends the brief to you, and powers `wingman ingest-gmail` ---
# App password at https://myaccount.google.com/apppasswords (needs 2FA). Free.
SMTP_USER=
SMTP_APP_PASSWORD=
